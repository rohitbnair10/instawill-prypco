# InstaWill environment configuration
#
# The LLM structuring step (src/lib/llm.ts + /api/structure) AND document OCR
# (src/lib/ocr.ts + /api/ocr, via Claude vision) both make a REAL Anthropic call
# when this key is present — one key, no extra OCR vendor. Without it, both fall
# back to a deterministic/simulated result, honestly labelled, so the prototype
# is fully usable offline. The trust boundary (validate before trusting) is
# identical on every path.

ANTHROPIC_API_KEY=

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Supabase (optional) ---
# The app ships with a localStorage-backed store so it runs with zero backend.
# supabase/schema.sql + seed.sql contain the production Postgres source of truth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
