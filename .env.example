# InstaWill environment configuration
#
# The LLM structuring step (src/lib/llm.ts + /api/structure) AND document OCR
# (src/lib/ocr.ts + /api/ocr, via Claude vision) both make a REAL Anthropic call
# when this key is present — one key, no extra OCR vendor. Without it, both fall
# back to a deterministic/simulated result, honestly labelled, so the prototype
# is fully usable offline. The trust boundary (validate before trusting) is
# identical on every path.

ANTHROPIC_API_KEY=

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Supabase (optional) ---
# The app ships with a localStorage-backed store so it runs with zero backend.
# supabase/schema.sql + seed.sql contain the production Postgres source of truth.
# supabase/storage.sql creates the `wills` Storage bucket + policies used for
# document uploads (src/lib/storage.ts). Without these set, uploads still work
# via a local browser object URL, clearly labelled as not shareable outside
# the current session.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never NEXT_PUBLIC_. Used by /api/clarifications and
# /api/approval-requests to mirror a lawyer's "Ask the client" / "Approve
# draft" click into Postgres (bypasses RLS, which has no anon write policy on
# leads/wills/clarifications by design). This is what lets the n8n workflows
# (n8n/clarification/, n8n/client-approval/) fire on a real lawyer-desk click
# instead of only manual test SQL. Find it in Supabase → Settings → API →
# service_role key.
SUPABASE_SERVICE_ROLE_KEY=
